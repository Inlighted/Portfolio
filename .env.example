# ---- EmailJS (https://www.emailjs.com) ----
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# ---- Calendly (https://calendly.com) ----
# Your event booking link. Connect Google Calendar + Google Meet inside
# Calendly (Settings -> Calendar Connections) to get automatic Meet links,
# calendar invites, confirmation emails and reminder emails.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-username/tutoring-session

# ---- GitHub ----
NEXT_PUBLIC_GITHUB_USERNAME=Inlighted

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
